{%- for section in site.data.catalog.sections -%}{%- for item in section.items -%}{%- assign skip = false -%}{%- if item.url contains '/mcp' or item.url contains 'helpdock' -%}{%- assign skip = true -%}{%- endif -%}{%- if item.url contains '.flisk.si' and skip == false -%}
  <url><loc>{{ item.url }}</loc></url>
{%- endif -%}{%- endfor -%}{%- endfor %}
{%- for entry in site.data.pages -%}{%- for pg in entry[1].pages -%}{%- assign depth = pg.url | remove: 'https://' | split: '/' | size -%}{%- unless depth < 2 or pg.url contains 'github.com' or pg.url contains 'npmjs.com' -%}
  <url><loc>{{ pg.url | xml_escape }}</loc></url>
{%- endunless -%}{%- endfor -%}{%- endfor %}
